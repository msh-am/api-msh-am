# api.msh.am Environment Configuration

API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# PotatoMesh Ingestor Authentication Token
API_TOKEN=msh_armenia_super_secret_token

# SQLite Database
DATABASE_PATH=./data/msh_am.sqlite3

# MQTT Configuration (mqtt.msh.am)
MQTT_ENABLED=true
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=msh/AM/#
MQTT_FALLBACK_TOPIC=msh/EU_868/#

# Privacy Controls
ENABLE_LOCATION_FUZZING=false
FUZZING_DECIMALS=2

# CORS Allowed Origins
CORS_ORIGINS=https://msh.am,http://localhost:3000,http://127.0.0.1:3000
